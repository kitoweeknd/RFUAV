*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments (uv / venv)
venv/
ENV/
env/
.venv/

# Testing / linting / type-checking caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Model weights & training artifacts
*.pth
*.pt
*.ckpt
checkpoints/
runs/
logs/
*.log
tensorboard/
*.tensorboard

# Datasets & raw RF/IQ data (keep local, don't commit)
data/
datasets/
*.iq
*.dat
*.cf32
*.cfile

# Run outputs (train / inference / benchmark / channel simulation)
# Keep the multi-config sweep runner + its YAML configs tracked (documented in
# README §2.8); ignore everything else under exp/ (results / scratch / caches).
exp/*
!exp/run_multi_cfg.py
!exp/cfg/
exp/cfg/*
!exp/cfg/*.yaml
output/
outputs/
res/
results/
benchmark_res/
benchmark result/
class_to_idx_pred2gt.json
run_meta.json

# Generated media: spectrograms / videos produced when running the pipelines.
# Committed documentation images under abstract/ (and the two example images)
# are re-included via the negations below.
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.pdf
*.eps
*.svg
*.fig
*.avi
*.mp4
*.mkv
!abstract/
!abstract/**
!example/example.png
!graphic/example.png

# NumPy / SciPy / MATLAB data blobs
*.npy
*.npz
*.mat
*.h5
*.hdf5

# Config: ignore stray/run-time YAML, but keep the sample configs.
# NOTE: the committed configs/*.yaml and example/**/*.yaml are already tracked
# and stay tracked; this rule only blocks NEW untracked YAML from sneaking in.
*.yaml
*.yml
!configs/sample.yaml
!ChannelSimulation/channel_pipeline.sample.yaml
!docker-compose.yml
# Sweep configs driven by exp/run_multi_cfg.py (test_cli args9). This negation
# must come after the global *.yaml above, or the later pattern would re-ignore
# them (gitignore: last matching pattern wins).
!exp/cfg/*.yaml

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Misc
*.tmp
*.temp
*.bak
*.orig
